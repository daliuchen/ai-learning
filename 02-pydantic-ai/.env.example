# ===== 模型：本手册 demo 默认用千问（阿里云百炼的 OpenAI 兼容端点）=====
# demo 里写的是 "openai-chat:qwen-flash"；Pydantic AI 的 openai provider 会读下面两个变量
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBED_MODEL=text-embedding-v4

# 想换回 OpenAI 官方：删掉 OPENAI_BASE_URL，并把 demo 里的 qwen-flash 换成官方模型名
# ===== 其它 Provider（可选）=====
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=

# ===== Logfire 可观测性（可选）=====
# LOGFIRE_TOKEN=pylf_xxx

# ===== MCP 实战 demo（可选，匿名访问 GitHub 每小时 60 次）=====
# GITHUB_TOKEN=ghp_xxx

# ===== 本地服务 =====
# OLLAMA_BASE_URL=http://localhost:11434
