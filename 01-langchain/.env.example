# ===== 模型供应商（默认千问，OpenAI 兼容接口） =====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
QWEN_EMBED_MODEL=text-embedding-v4
# 注意：langchain-openai 会优先读 OPENAI_API_BASE，shell 里如有残留请 unset，否则会覆盖上面的 OPENAI_BASE_URL

# 想用 OpenAI 官方：OPENAI_BASE_URL=https://api.openai.com/v1，QWEN_MODEL=gpt-4o-mini，QWEN_EMBED_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# ===== LangSmith（可观测性，新变量名是 LANGSMITH_*，旧的 LANGCHAIN_* 仅作兼容） =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=langchain-tutorial
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===== 工具（可选） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 本地服务（可选） =====
# 比如本地起的 ollama
OLLAMA_BASE_URL=http://localhost:11434
