OPENAI_API_KEY=sk-...
# 用第三方 OpenAI 兼容端点（如千问）时再填；同时需要 set_default_openai_api("chat_completions")
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 不写 model 时的默认模型（SDK 内置默认是 gpt-5.6-luna）
# OPENAI_DEFAULT_MODEL=gpt-6.1-sol

# Tracing（默认走 OpenAI Platform Dashboard，需要 OpenAI key）
# 关闭可设：
# OPENAI_AGENTS_DISABLE_TRACING=1
# 不上传 LLM/工具的输入输出内容：
# OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0

# 外接观测平台
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openai-agents-learning

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LOGFIRE_TOKEN=

# Multi-provider（用 LiteLLM 时）
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Realtime / Voice
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
