# 复制成 .env 并填写；不要提交 .env。
# 注意：mcp 2.x 不再自动读取 .env / MCP_* 环境变量，demo 需要你自己 export（或 `set -a; . .env; set +a`）。

# ===== 模型（OpenAI 兼容接口；本手册 demo 默认用阿里云百炼千问 qwen-flash）=====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
QWEN_EMBED_MODEL=text-embedding-v4
# 注意：langchain-openai 会优先读 OPENAI_API_BASE（旧名），请别设它，或在代码里显式传 base_url

# ===== 07-practice/03 PR 评审助手（真实对接 GitHub 时才需要；自测不需要）=====
GITHUB_TOKEN=github_pat_xxx

# ===== 05-production 多实例部署（所有副本共享同一把 key、同一个 Server 名）=====
# python -c "import secrets; print(secrets.token_hex(32))"
MCP_STATE_KEY=
MCP_SERVER_NAME=remote-demo
ALLOWED_HOSTS=127.0.0.1,localhost

# ===== 可选：Logfire / OTLP 可观测 =====
LOGFIRE_TOKEN=lf_xxx
